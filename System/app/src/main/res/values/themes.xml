<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.OOPProject" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/dark_purple</item>
        <!-- Splash Screen Window Backgrounds (Fixes Android 12+ White Flash Screen) -->
        <item name="android:windowBackground">@color/dark_purple</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/dark_purple</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/app_logo</item>
    </style>
</resources>
